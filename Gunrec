-- ============================================================
-- COLOUR
-- ============================================================

local function gunColour()
    if gun.rainbow then
        return Color3.fromHSV(gun.hue, 0.9, 1)
    end

    return TINT[gun.colour]
end

local function beamColour()
    if beam.rainbow then
        return Color3.fromHSV(beam.hue, 0.9, 1)
    end

    return TINT[beam.colour]
end

local function bombColour()
    if bomb.rainbow then
        return Color3.fromHSV(bomb.hue, 0.9, 1)
    end

    return TINT[bomb.colour]
end

-- ============================================================
-- GUN PIPELINE
-- ============================================================

local function cacheOriginal(obj)
    if original[obj] then return end

    local entry = {parts = {}}

    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then
            table.insert(entry.parts, {
                d,
                d.Color,
                d.Material,
                d:IsA("MeshPart") and d.TextureID or ""
            })
        end
    end

    original[obj] = entry
end

local function restoreOriginal(obj)
    local e = original[obj]
    if not e then return end

    for _, p in ipairs(e.parts) do
        local inst, col, mat, tex = p[1], p[2], p[3], p[4]

        if inst.Parent then
            inst.Color = col

            pcall(function()
                inst.Material = mat
            end)

            if inst:IsA("MeshPart") then
                pcall(function()
                    inst.TextureID = tex
                end)
            end

            local sa = inst:FindFirstChildOfClass("SurfaceAppearance")

            if sa then
                sa:Destroy()
            end
        end
    end
end

local function toolVariant(tool)
    local n = (
        tool:GetAttribute("ItemName")
        or tool:GetAttribute("ItemID")
        or tool.Name
        or ""
    ):lower()

    if n:find("matrix") then
        return "matrix"
    end

    if n:find("void") then
        return "void"
    end

    return nil
end

local function shouldTintTool(tool)
    local v = toolVariant(tool)

    if v == "matrix" and gun.matrix_on then
        return true
    end

    if v == "void" and gun.void_on then
        return true
    end

    return false
end

local function applyGunMesh(tool, colour)
    cacheOriginal(tool)

    local handle = tool:FindFirstChild("Handle")

    if handle and handle:IsA("MeshPart") then
        handle.Material = Enum.Material.SmoothPlastic
        handle.Color = colour

        local orig = original[tool]
        local originalTex = ""

        if orig then
            for _, p in ipairs(orig.parts) do
                if p[1] == handle then
                    originalTex = p[4]
                    break
                end
            end
        end

        if not originalTex or #originalTex == 0 then
            originalTex = handle.TextureID
        end

        if keep_tex then
            local sa = handle:FindFirstChildOfClass("SurfaceAppearance")

            if not sa then
                sa = Instance.new("SurfaceAppearance")
                sa.Parent = handle
            end

            sa.ColorMap = originalTex
            sa.Color = colour
            sa.AlphaMode = Enum.AlphaMode.Transparency
            sa.Roughness = 0
            sa.Metalness = 0.3

            pcall(function()
                sa.NormalMap = ""
            end)

            pcall(function()
                sa.RoughnessMap = ""
            end)

            pcall(function()
                sa.MetalnessMap = ""
            end)

            handle.TextureID = originalTex
        else
            local sa = handle:FindFirstChildOfClass("SurfaceAppearance")

            if sa then
                sa:Destroy()
            end

            handle.TextureID = ""
        end
    end

    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") and d ~= handle then
            d.Color = colour

        elseif d:IsA("Trail") then
            d.Color = ColorSequence.new(colour)

        elseif d:IsA("PointLight")
            or d:IsA("SpotLight")
            or d:IsA("SurfaceLight") then
            d.Color = colour
        end
    end
end

-- ============================================================
-- GUN DISPLAY FIX
-- Finds the SINGLE GunDisplay closest to the equipped gun.
-- Works whether GunDisplay itself is a Part, Model, or Folder.
-- ============================================================

local function getDisplayOrigin(obj)
    if obj:IsA("BasePart") then
        return obj.Position
    end

    if obj:IsA("Model") then
        local ok, pivot = pcall(function()
            return obj:GetPivot()
        end)

        if ok and pivot then
            return pivot.Position
        end
    end

    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then
            return d.Position
        end
    end

    return nil
end

local function getGunOrigin()
    -- First try the currently equipped tool.
    local character = LocalPlayer.Character

    if character then
        for _, obj in ipairs(character:GetChildren()) do
            if obj:IsA("Tool") then
                local variant = toolVariant(obj)

                if variant == "matrix" or variant == "void" then
                    local handle = obj:FindFirstChild("Handle")

                    if handle and handle:IsA("BasePart") then
                        return handle.Position
                    end

                    local pos = getDisplayOrigin(obj)

                    if pos then
                        return pos
                    end
                end
            end
        end

        -- Fallback to character position.
        local root = character:FindFirstChild("HumanoidRootPart")

        if root and root:IsA("BasePart") then
            return root.Position
        end
    end

    return nil
end

local function tintDisplayObject(obj, colour)
    if obj:IsA("BasePart") then
        obj.Material = Enum.Material.SmoothPlastic
        obj.Color = colour

        if obj:IsA("MeshPart") and keep_tex and obj.TextureID ~= "" then
            local originalTex = obj.TextureID
            local sa = obj:FindFirstChildOfClass("SurfaceAppearance")

            if not sa then
                sa = Instance.new("SurfaceAppearance")
                sa.Parent = obj
            end

            sa.ColorMap = originalTex
            sa.Color = colour
            sa.AlphaMode = Enum.AlphaMode.Transparency
            sa.Roughness = 0
            sa.Metalness = 0.3
        end

    elseif obj:IsA("Trail") then
        obj.Color = ColorSequence.new(colour)

    elseif obj:IsA("Beam") then
        obj.Color = ColorSequence.new(colour)

    elseif obj:IsA("ParticleEmitter") then
        obj.Color = ColorSequence.new(colour)

    elseif obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
        obj.Color = colour
    end
end

local function tintWaistDisplays(colour)
    local wd = workspace:FindFirstChild("WeaponDisplays")

    if not wd then
        return
    end

    local gunPosition = getGunOrigin()

    if not gunPosition then
        return
    end

    local closestDisplay = nil
    local closestDistance = math.huge

    -- Find the nearest GunDisplay.
    for _, d in ipairs(wd:GetDescendants()) do
        if d.Name == "GunDisplay" then
            local position = getDisplayOrigin(d)

            if position then
                local distance = (position - gunPosition).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closestDisplay = d
                end
            end
        end
    end

    -- Tint ONLY the closest GunDisplay.
    if closestDisplay then
        tintDisplayObject(closestDisplay, colour)

        for _, d in ipairs(closestDisplay:GetDescendants()) do
            tintDisplayObject(d, colour)
        end
    end
end

local function applyGun()
    local colour = gunColour()

    if not colour then
        return
    end

    local anyOn = gun.matrix_on or gun.void_on

    if anyOn then
        if LocalPlayer.Character then
            for _, c in ipairs(LocalPlayer.Character:GetChildren()) do
                if c:IsA("Tool") and shouldTintTool(c) then
                    applyGunMesh(c, colour)
                elseif c:IsA("Tool") then
                    restoreOriginal(c)
                end
            end
        end

        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")

        if bp then
            for _, c in ipairs(bp:GetChildren()) do
                if c:IsA("Tool") and shouldTintTool(c) then
                    applyGunMesh(c, colour)
                end
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and (obj.Name == "Gun" or obj.Name == "gun") then
                if shouldTintTool(obj) then
                    applyGunMesh(obj, colour)
                else
                    restoreOriginal(obj)
                end
            end
        end

        -- NEW: only tint the nearest GunDisplay.
        tintWaistDisplays(colour)

    else
        for obj in pairs(original) do
            if obj:IsA("Tool") then
                restoreOriginal(obj)
            end
        end
    end
end

-- ============================================================
-- BEAM
-- ============================================================

local function findBeam()
    for _, c in ipairs({
        LocalPlayer.Character,
        LocalPlayer:FindFirstChild("Backpack")
    }) do
        if not c then
            continue
        end

        local g = c:FindFirstChild("Gun")

        if g and g:IsA("Tool") then
            local h = g:FindFirstChild("Handle")

            if h then
                local b = h:FindFirstChild("CustomBeam")

                if b and b:IsA("Beam") then
                    return b
                end
            end
        end
    end
end

local function applyBeam()
    if not beam.on then
        return
    end

    local col = beamColour()

    if not col then
        return
    end

    local b = findBeam()

    if b then
        b.Color = ColorSequence.new(col)
        b.LightEmission = 1
    end
end

-- ============================================================
-- BOMB
-- ============================================================

local function ownsBomb(bombName)
    local containers = {
        LocalPlayer.Character,
        LocalPlayer:FindFirstChildOfClass("Backpack"),
        LocalPlayer:FindFirstChildOfClass("PlayerGui"),
    }

    for _, c in ipairs(containers) do
        if c then
            for _, v in ipairs(c:GetDescendants()) do
                if v.Name:lower() == bombName:lower() then
                    return true
                end
            end
        end
    end

    return false
end

local function tintBombPart(part, colour)
    if part:IsA("Beam")
        or part:IsA("Trail")
        or part:IsA("ParticleEmitter") then

        part.Color = ColorSequence.new(colour)
        return
    end

    if not part:IsA("BasePart") then
        return
    end

    part.Color = colour

    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("SurfaceAppearance") then
            pcall(function()
                child.Color = colour
            end)

            if WHITE_ASSET_ID ~= "" then
                pcall(function()
                    child.ColorMap = WHITE_ASSET_ID
                end)
            end

        elseif child:IsA("SpecialMesh") then
            pcall(function()
                child.VertexColor = Vector3.new(
                    colour.R,
                    colour.G,
                    colour.B
                )
            end)
        end
    end
end

local function applyBomb()
    if not bomb.on then
        return
    end

    local colour = bombColour()

    if not colour then
        return
    end

    local haveFake = ownsBomb("FakeBomb")
    local haveGold = ownsBomb("GoldBomb")

    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()

        local isFake = n:find("fakebomb") ~= nil
        local isGold = n:find("goldbomb") ~= nil

        if (isFake and haveFake) or (isGold and haveGold) then
            if obj:IsA("BasePart") then
                tintBombPart(obj, colour)

            elseif obj:IsA("Model") or obj:IsA("Folder") then
                for _, d in ipairs(obj:GetDescendants()) do
                    if d:IsA("BasePart") then
                        tintBombPart(d, colour)
                    end
                end
            end
        end
    end
end

