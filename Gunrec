-- GUN
-- ============================================================

local function swapToolSolid(tool, id)
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("MeshPart") then
            saClear(d)
            setTexture(d, id, true)
        elseif d:IsA("Decal") or d:IsA("Texture") or d:IsA("SurfaceAppearance") then
            setTexture(d, id, true)
        end
    end
end

local function rainbowTool(tool, colour)
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("MeshPart") then
            restoreTexture(d)
            saTint(d, colour)
        elseif d:IsA("Decal") or d:IsA("Texture") then
            restoreTexture(d)
            pcall(function() d.Color3 = colour end)
        elseif d:IsA("Trail") or d:IsA("Beam") or d:IsA("ParticleEmitter") then
            pcall(function() d.Color = ColorSequence.new(colour) end)
        elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
            pcall(function() d.Color = colour end)
        end
    end
end

local function tintDisplayObject(inst, colour)
    if inst:IsA("MeshPart") then
        restoreTexture(inst)
        saTint(inst, colour)
    elseif inst:IsA("BasePart") then
        pcall(function() inst.Color = colour end)
    elseif inst:IsA("Decal") or inst:IsA("Texture") then
        restoreTexture(inst)
        pcall(function() inst.Color3 = colour end)
    elseif inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("ParticleEmitter") then
        pcall(function() inst.Color = ColorSequence.new(colour) end)
    elseif inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
        pcall(function() inst.Color = colour end)
    end
end

local function applyGun()
    local tools = {}
    if LocalPlayer.Character then
        for _, c in ipairs(LocalPlayer.Character:GetChildren()) do
            if c:IsA("Tool") and isMatrixOrVoid(c) then
                table.insert(tools, c)
            end
        end
    end

    if gun.rainbow then
        local col = rainbowColour(gun.hue)
        for _, t in ipairs(tools) do rainbowTool(t, col) end

        local display = nearestDisplay()
        if display then
            tintDisplayObject(display, col)
            for _, d in ipairs(display:GetDescendants()) do
                tintDisplayObject(d, col)
            end
        end
    else
        local id = COLORS[gun.colour]
        if not id then return end
        for _, t in ipairs(tools) do swapToolSolid(t, id) end

        local display = nearestDisplay()
        if display then
            local function attempt(inst)
                saClear(inst)
                setTexture(inst, id, true)
            end
            attempt(display)
            for _, c in ipairs(display:GetDescendants()) do
                if c:IsA("Texture") or c:IsA("Decal") or c:IsA("SurfaceAppearance")
                   or c:IsA("MeshPart") or c:IsA("ImageLabel") then
                    attempt(c)
                end
            end
        end
    end
end

-- ============================================================
-- BEAM
-- ============================================================

local function findBeam()
    for _, c in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack") }) do
        if c then
            local g = c:FindFirstChild("Gun")
            if g and g:IsA("Tool") then
                local h = g:FindFirstChild("Handle")
                if h then
                    local b = h:FindFirstChild("CustomBeam")
                    if b and b:IsA("Beam") then return b end
                end
            end
        end
    end
end

local function applyBeam()
    if not beam.on then return end
    local b = findBeam()
    if not b then return end

    pcall(function() b.Width0 = 0.2 end)
    pcall(function() b.Width1 = 0.2 end)
    pcall(function() b.FaceCamera = true end)
    pcall(function()
        b.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0.0, 0.0),
            NumberSequenceKeypoint.new(0.5, 0.1),
            NumberSequenceKeypoint.new(1.0, 0.0),
        })
    end)
    pcall(function() b.LightEmission = 2 end)
    pcall(function() b.Segments = 10 end)

    if beam.rainbow then
        b.Color = rainbowSequence(0)   -- static full spectrum inside one beam
    else
        b.Color = ColorSequence.new(beamColour())
    end
end

-- ============================================================
-- BOMB
-- ============================================================

local function ownsBomb(bombName)
    local containers = {
        LocalPlayer.Character,
        LocalPlayer:FindFirstChildOfClass("Backpack"),
        LocalPlayer:FindFirstChildOfClass("PlayerGui"),
    }
    for _, c in ipairs(containers) do
        if c then
            for _, v in ipairs(c:GetDescendants()) do
                if v.Name:lower() == bombName:lower() then return true end
            end
        end
    end
    return false
end

local function tintBombPart(part, colour)
    if part:IsA("Beam") or part:IsA("Trail") or part:IsA("ParticleEmitter") then
        part.Color = ColorSequence.new(colour)
        return
    end
    if not part:IsA("BasePart") then return end
    part.Color = colour
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("SurfaceAppearance") then
            pcall(function() child.Color = colour end)
        elseif child:IsA("SpecialMesh") then
            pcall(function()
                child.VertexColor = Vector3.new(colour.R, colour.G, colour.B)
            end)
        end
    end
end

local function applyBomb()
    if not bomb.on then return end
    local colour = bombColour()
    if not colour then return end
    local haveFake = ownsBomb("FakeBomb")
    local haveGold = ownsBomb("GoldBomb")
    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()
        local isFake = n:find("fakebomb") ~= nil
        local isGold = n:find("goldbomb") ~= nil
        if (isFake and haveFake) or (isGold and haveGold) then
            if obj:IsA("BasePart") then
                tintBombPart(obj, colour)
            elseif obj:IsA("Model") or obj:IsA("Folder") then
                for _, d in ipairs(obj:GetDescendants()) do
                    if d:IsA("BasePart") then tintBombPart(d, colour) end
                end
            end
        end
    end
end

