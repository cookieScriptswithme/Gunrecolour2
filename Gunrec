-- ============================================================

local function hookChar(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.wait(0.15)
            applyGun()
            applyBeam()
        end
    end)

    task.wait(0.5)

    applyGun()
    applyBeam()
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)

    if LocalPlayer.Character then
        hookChar(LocalPlayer.Character)
    end

    applyBeam()
end)

if LocalPlayer.Character then
    hookChar(LocalPlayer.Character)
end

local bp0 = LocalPlayer:FindFirstChildOfClass("Backpack")

if bp0 then
    bp0.ChildAdded:Connect(function()
        task.wait(0.15)
        applyGun()
        applyBeam()
    end)
end

RunService.RenderStepped:Connect(function(dt)
    if gun.rainbow and (gun.matrix_on or gun.void_on) then
        gun.hue = (gun.hue + dt * 0.35) % 1
        applyGun()
    end
end)

RunService.Heartbeat:Connect(function(dt)
    if not beam.on then
        return
    end

    if beam.rainbow then
        beam.hue = (beam.hue + dt * 0.35) % 1
    end

    applyBeam()
end)

RunService.Heartbeat:Connect(function(dt)
    if not bomb.on then
        return
    end

    if bomb.rainbow then
        bomb.hue = (bomb.hue + dt * 0.35) % 1
    end

    applyBomb()
end)
