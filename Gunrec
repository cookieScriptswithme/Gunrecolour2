local TARGET_NAMES = {
    ["GunDisplay"]   = true,
    ["MatrixScope"]  = true,
    ["VoidScope"]    = true,
    ["Matrix Scope"] = true,
    ["Void Scope"]   = true,
}

local PROP_BY_CLASS = {
    Texture            = "Texture",
    Decal              = "Texture",
    SurfaceAppearance  = "ColorMap",
    MeshPart           = "TextureID",
    Part               = "TextureID",
    TrussPart          = "TextureID",
    ImageLabel         = "Image",
    ImageButton        = "Image",
}

local TEXTURE_PROP_CANDIDATES = { "TextureID", "TextureId", "Texture", "ColorMap", "Image" }

local original_tex = {}

local function setTexture(inst, id, remember)
    local ordered = {}
    local primary = PROP_BY_CLASS[inst.ClassName]
    if primary then table.insert(ordered, primary) end
    for _, p in ipairs(TEXTURE_PROP_CANDIDATES) do
        if p ~= primary then table.insert(ordered, p) end
    end
    for _, prop in ipairs(ordered) do
        if pcall(function() return inst[prop] end) then
            local prev = inst[prop]
            if remember and prev ~= nil and prev ~= "" then
                original_tex[inst] = original_tex[inst] or {}
                if original_tex[inst][prop] == nil then
                    original_tex[inst][prop] = prev
                end
            end
            if pcall(function() inst[prop] = id end) then
                return true, prop
            end
        end
    end
    return false
end

local function restoreTexture(inst)
    local remembered = original_tex[inst]
    if not remembered then return end
    for prop, val in pairs(remembered) do
        pcall(function() inst[prop] = val end)
    end
end

local function isGunDisplay(inst)
    return inst and inst.Name and TARGET_NAMES[inst.Name] == true
end

local function nearestDisplay()
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bestDist
    for _, d in ipairs(Workspace:GetDescendants()) do
        if isGunDisplay(d) and d:IsA("BasePart") then
            local dist = (d.Position - hrp.Position).Magnitude
            if not bestDist or dist < bestDist then
                best, bestDist = d, dist
            end
        end
    end
    return best
end

local function isMatrixOrVoid(tool)
    local n = (
        tool:GetAttribute("ItemName")
        or tool:GetAttribute("ItemID")
        or tool.Name or ""
    ):lower()
    return n:find("matrix") ~= nil or n:find("void") ~= nil
end

local function saTint(inst, colour)
    if not inst:IsA("MeshPart") then return end
    local sa = inst:FindFirstChildOfClass("SurfaceAppearance")
    if not sa then
        sa = Instance.new("SurfaceAppearance")
        sa.Parent = inst
        if inst.TextureID ~= "" then
            pcall(function() sa.ColorMap = inst.TextureID end)
        end
    end
    pcall(function() sa.Color = colour end)
    pcall(function() sa.AlphaMode = Enum.AlphaMode.Transparency end)
    pcall(function() sa.Roughness = 0 end)
    pcall(function() sa.Metalness = 0.3 end)
end

local function saClear(inst)
    if not inst:IsA("MeshPart") then return end
    local sa = inst:FindFirstChildOfClass("SurfaceAppearance")
    if sa then sa:Destroy() end
end

