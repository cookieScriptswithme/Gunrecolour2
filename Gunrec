-- ============================================================
-- COLOUR
-- ============================================================

local function rainbowColour(hue) return Color3.fromHSV(hue, 1, 1) end

local function beamColour()
    if beam.rainbow then return rainbowColour(beam.hue) end
    return BEAM_TINT[beam.colour]
end
local function bombColour()
    if bomb.rainbow then return rainbowColour(bomb.hue) end
    return BOMB_TINT[bomb.colour]
end

-- static full spectrum packed into one beam
local function rainbowSequence(hueOffset)
    hueOffset = hueOffset or 0
    local stops = {}
    local N = 12
    for i = 0, N do
        local t = i / N
        local hue = (t + hueOffset) % 1
        table.insert(stops, ColorSequenceKeypoint.new(t, Color3.fromHSV(hue, 1, 1)))
    end
    return ColorSequence.new(stops)
end

