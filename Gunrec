    ui.bombRainbow.BorderSizePixel = 0
    applyBomb()
end
for key, btn in pairs(ui.bombButtons) do
    btn.MouseButton1Click:Connect(function() selectBombColour(key) end)
end

ui.bombRainbow.MouseButton1Click:Connect(function()
    bomb.rainbow = not bomb.rainbow
    ui.bombRainbow.BorderSizePixel = bomb.rainbow and 2 or 0
    if bomb.rainbow then
        for _, b in pairs(ui.bombButtons) do b.BorderSizePixel = 0 end
    end
    applyBomb()
end)

ui.bombToggle.MouseButton1Click:Connect(function()
    bomb.on = not bomb.on
    ui.bombToggle.Text = "Change Bomb Colours: " .. (bomb.on and "ON" or "OFF")
    ui.bombToggle.BackgroundColor3 =
        bomb.on and Color3.fromRGB(200, 130, 40) or Color3.fromRGB(30, 30, 50)
    applyBomb()
end)

-- ============================================================
-- EQUIP HOOK
-- ============================================================

local function hookChar(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.wait(0.15)
            applyGun()
            applyBeam()
        end
    end)
    task.wait(0.5)
    applyGun()
    applyBeam()
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    hookChar(char)
    applyBeam()
end)

if LocalPlayer.Character then
    hookChar(LocalPlayer.Character)
end

local bp0 = LocalPlayer:FindFirstChildOfClass("Backpack")
if bp0 then
    bp0.ChildAdded:Connect(function()
        task.wait(0.15)
        applyGun()
        applyBeam()
    end)
end

-- ============================================================
-- LOOPS
-- ============================================================

RunService.Heartbeat:Connect(function(dt)
    if not gun.rainbow then return end
    gun.hue = (gun.hue + dt * 0.35) % 1
    applyGun()
end)

RunService.Heartbeat:Connect(function(dt)
    if not beam.on then return end
    applyBeam()   -- static spectrum; re-apply each frame so it survives game re-writes
end)

RunService.Heartbeat:Connect(function(dt)
    if not bomb.on then return end
    if bomb.rainbow then
        bomb.hue = (bomb.hue + dt * 0.35) % 1
    end
    applyBomb()
end)
